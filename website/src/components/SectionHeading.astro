---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
}

const { eyebrow, title, subtitle, align = "center" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary/80">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base-content/60">{subtitle}</p>}
</div>
